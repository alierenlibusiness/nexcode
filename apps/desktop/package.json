{
  "name": "@nexcode/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "description": "NEXCODE; çoklu-agent, paralel vibe coding masaüstü IDE",
  "author": "NEXCODE",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild-native": "npx -y @electron/rebuild -f -w better-sqlite3",
    "start": "electron .",
    "package:dir": "npx -y electron-builder --windows --dir",
    "package": "npx -y electron-builder --windows"
  },
  "dependencies": {
    "@nexcode/core": "workspace:*",
    "@napi-rs/keyring": "^1.1.7",
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  }
}
