{
  "name": "@nexcode/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild-native": "npx -y @electron/rebuild -f -w better-sqlite3",
    "start": "electron .",
    "package:dir": "npx -y electron-builder --windows --dir",
    "package": "npx -y electron-builder --windows"
  },
  "dependencies": {
    "@nexcode/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  }
}
