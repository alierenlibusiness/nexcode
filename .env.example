# NEXCODE ortam değişkenleri (örnek). Gerçek .env asla commit edilmez.

# Geliştirmede Electron'un yükleyeceği renderer dev sunucusu.
# Boş bırakılırsa apps/renderer/out statik export'u yüklenir.
NEXCODE_RENDERER_URL=http://localhost:3000

# NOT: AI sağlayıcı API anahtarları .env'de DEĞİL, OS keychain'de saklanır
# (bkz. @nexcode/core/keyring). Buraya API anahtarı yazmayın.
